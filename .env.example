# 공공데이터 API 인증키
#
# 사용법
#   cp .env.example .env
#   open -e .env        (편집기로 열어 = 뒤에 키를 붙여넣고 저장)
#
# 따옴표는 붙이지 않습니다. 앞뒤 공백도 넣지 마세요.
# .env 는 .gitignore 에 있어 GitHub 에 올라가지 않고, 앱 번들에도 들어가지 않습니다.
# 키는 데이터를 내려받을 때만 쓰고, 앱에는 내려받은 결과(JSON)만 포함됩니다.


# ── 1) 공공데이터포털 (data.go.kr) ─────────────────────────────
#
# 마이페이지 → 오픈API → 개발계정 → "일반 인증키(Decoding)"
# %2B 나 %3D 같은 문자가 섞여 있으면 Encoding 키입니다. 그 아래 Decoding 키를 쓰세요.

DATA_GO_KR_KEY=


# ── 2) 식품안전나라 (foodsafetykorea.go.kr) ────────────────────
#
# 식품안전나라는 계정당 인증키가 1개입니다.
# API 를 3개 신청하셨다면 목록에 3줄로 보이지만 키 값은 대개 같습니다.
# 세 줄의 앞 8자리를 비교해 보시고,
#
#   같으면  → 아래 FOODSAFETY_KEY 한 줄에만 넣고 나머지는 비워 두세요.
#   다르면  → 서비스별 칸에 각각 넣으세요. 비어 있으면 FOODSAFETY_KEY 를 대신 씁니다.

FOODSAFETY_KEY=

# 아래 세 줄은 키가 서로 다를 때만 채우면 됩니다. 같으면 그냥 비워 두세요.
FOODSAFETY_KEY_BARCODE=          # 유통바코드 (I2570)
FOODSAFETY_KEY_PRODUCT=          # 바코드연계제품정보 (C005)
FOODSAFETY_KEY_MANUFACTURE=      # 식품(첨가물)품목제조보고 (I1250)


# 온코푸드 앱이 쓰는 서버 설정 (문의·로그인)
#
# Supabase 대시보드 → Project Settings → API 에서 복사해 .env 에 넣으세요.
# 비어 있으면 문의·로그인 기능만 꺼지고 나머지는 그대로 동작합니다.
#
# ⚠️ 이 두 값은 브라우저에 노출되는 공개 키입니다(anon = 공개용).
#    비밀로 다뤄야 하는 service_role 키는 절대 여기에 넣지 마세요.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
