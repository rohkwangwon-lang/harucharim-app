{
  /*
   * 검사 스크립트도 타입 검사에 넣는다.
   *
   * 여태 tsc 는 src 만 보고 있었다. 그래서 앱을 지키는 검사 자체가 무방비였고,
   * patient.ts 가 존재하지 않는 치료 시기('pre_op')를 쓰고 있어도 아무도 몰랐다.
   * README 가 경고해 둔 실수인데도 새 검사에서 되살아났다 — 사람의 주의로는 안 된다.
   *
   * 목적은 스크립트를 엄격하게 만드는 것이 아니라, '없는 값을 쓰는 것' 을 잡는 것이다.
   * 그래서 앱 설정과 같은 해석 방식을 쓰되 암묵적 any 는 문제 삼지 않는다.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts", "src/vite-env.d.ts"]
}
